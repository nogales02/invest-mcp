# Copy to .env (or set as real environment variables) and adjust.
# All variables are optional; sensible defaults are auto-detected.

# Full path to the InVEST CLI executable. Auto-detected from an installed
# InVEST Workbench if left unset.
# INVEST_MCP_INVEST_EXE=C:\Program Files\InVEST 3.20.1 Workbench\resources\invest\invest.exe

# python.exe of the "invest-geo" conda env (used for the geospatial preflight).
# Auto-detected from common conda locations if left unset.
# INVEST_MCP_GEO_PYTHON=C:\Users\<you>\.conda\envs\invest-geo\python.exe

# python.exe of the "invest-cal" conda env (natcap.invest + spotpy, used for
# model calibration). Auto-detected if left unset.
# INVEST_MCP_CAL_PYTHON=C:\Users\<you>\.conda\envs\invest-cal\python.exe

# Root folder where job workspaces, datastacks and logs are written.
# Default: %USERPROFILE%\invest-mcp-data
# INVEST_MCP_DATA_ROOT=Y:\Server-UserFolder\Escritorio\InVEST_runs

# Extra folders from which the server is allowed to READ input files.
# Separate multiple paths with ';' (Windows) or ':' (POSIX).
# The data root and the server's working directory are always allowed.
# INVEST_MCP_ALLOWED_INPUT_DIRS=Y:\Server-UserFolder\Escritorio\GIS_data;D:\datasets

# Max number of InVEST model runs executing at the same time.
# INVEST_MCP_MAX_CONCURRENT_JOBS=2

# Hard timeout for a single model run, in seconds (default 6 h).
# INVEST_MCP_INVEST_TIMEOUT_SECONDS=21600

# InVEST locale for messages / reports (e.g. es, en, zh). Unset = InVEST default.
# INVEST_MCP_LOCALE=es
